{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-tcp-{{port}}",
      "listen": "0.0.0.0",
      "port": {{port}},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{uuid}}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}
